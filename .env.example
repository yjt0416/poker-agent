# scripts/start.ps1 or scripts/start.sh generates DATABASE_PASSWORD on first run.
DATABASE_PASSWORD=
WEB_PORT=8088
AGENT_TAVERN_AGENT_PROVIDER=local
# Only use a newly issued key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_OUTPUT_TOKENS=512
DEEPSEEK_MAX_REQUESTS_PER_HOUR=120
# Set true only when accessing through an HTTPS reverse proxy.
AGENT_TAVERN_SECURE_COOKIE=false
AGENT_TAVERN_CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088
